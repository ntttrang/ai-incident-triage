# Application
APP_ENV=development
APP_PORT=8085
LOG_LEVEL=info

# Observability / OpenTelemetry
OTEL_SERVICE_NAME=ai-incident-triage
SERVICE_VERSION=1.0.0
# Leave empty to disable tracing (no-op provider). docker compose sets otel-collector:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_incident_triage
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Migrations
MIGRATIONS_PATH=file://migrations

# LLM classification (worker) — set real values only in .env, never commit them.
# An empty key is valid: every incident then classifies via the deterministic
# heuristic fallback (no-credential demo mode).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-chat-latest
# Must stay at least 30s below the worker's 150s per-job budget — the worker
# refuses to start otherwise (the fallback needs that room to persist results).
OPENAI_TIMEOUT_SECS=60

# Worker internals. CLASSIFY_FORCE_FAIL (llm | heuristic | all) short-circuits
# the chosen classifier so degradation paths are demonstrable without breaking
# real credentials — test/demo only, leave empty otherwise.
WORKER_METRICS_PORT=8086
CLASSIFY_FORCE_FAIL=

# Jira webhook signature verification. Required (fail-closed): the app refuses
# to boot without it. docker compose falls back to a known dev value
# (dev-webhook-secret-change-me) so a fresh clone boots; `make seed` uses the
# same fallback. Set a real secret here before pointing a real Jira at the API.
WEBHOOK_SECRET=
