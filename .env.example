# Application
APP_ENV=development
APP_PORT=8085
LOG_LEVEL=info

# Observability / OpenTelemetry
OTEL_SERVICE_NAME=ai-incident-triage
SERVICE_VERSION=1.0.0
# Leave empty to disable tracing (no-op provider). docker compose sets otel-collector:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_incident_triage
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Migrations
MIGRATIONS_PATH=file://migrations

# LLM classification (worker) — set real values only in .env, never commit them
OPENAI_API_KEY=

# Jira webhook signature verification — set real values only in .env, never commit them
WEBHOOK_SECRET=
